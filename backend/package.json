{
  "name": "habit-bloom-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:show": "node src/view-data.js",
    "test:unit": "node node_modules/vitest/vitest.mjs run tests/unit --reporter=verbose",
    "test:integration": "node node_modules/vitest/vitest.mjs run tests/integration --reporter=verbose --maxWorkers=1",
    "test": "node node_modules/vitest/vitest.mjs run --reporter=verbose --maxWorkers=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
