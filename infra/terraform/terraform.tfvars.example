tenancy_ocid       = "ocid1.tenancy.oc1..reemplazar"
compartment_ocid   = "ocid1.compartment.oc1..reemplazar"
region             = "sa-saopaulo-1"
oci_profile        = "DEFAULT"
ssh_public_key_path = "~/.ssh/habit_bloom_oci.pub"
ssh_allowed_cidr    = "203.0.113.10/32"

# Shape x86 flexible cubierto inicialmente por los créditos de la suscripción.
instance_shape      = "VM.Standard.E3.Flex"
instance_ocpus      = 1
instance_memory_gbs = 4
